@page
@using global::GestionReservations.Models
@model GestionReservation.Pages.Voitures.EditModel
@{
}

<h2>Modification</h2>
<div class="row">
    <div class="col-sm-2">
        <form method="post">
            <div class="form-group">
                <label>Marque</label>
                <select asp-for="Voiture.Marque" asp-items="Html.GetEnumSelectList<Marque>()"></select>
            </div>

            <div class="form-group">
                <label>Prix</label>
                <input asp-for="Voiture.PrixJournalier" class="form-control" />
                <span asp-validation-for="Voiture.PrixJournalier"></span>
            </div>

            <div class="form-group">
                <label>Description</label>
                <input asp-for="Voiture.Description" class="form-control" />
            </div>

            <div class="form-group">
                <label>Année</label>
                <input asp-for="Voiture.AnneeFabrication" class="form-control" />
            </div>

            <div class="form-group">
                <input type="submit" name="btnAjouter" value="Ajouter" class="btn btn-success" />
            </div>
        </form>

    </div>
</div>