@page
@using global::GestionReservations.Models
@model GestionReservation.Pages.Voitures.EditModel
@{
}

<h2>Modification</h2>
<div class="row">
    <div class="col-sm-2">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Voiture.Marque" class="control-label"></label>
                <select asp-for="Voiture.Marque" asp-items="Html.GetEnumSelectList<Marque>()"></select>
            </div>

            <div class="form-group">
                <label asp-for="Voiture.PrixJournalier" class="control-label"></label>
                <input asp-for="Voiture.PrixJournalier" class="form-control" />
                <span asp-validation-for="Voiture.PrixJournalier" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Voiture.Description" class="control-label"></label>
                <input asp-for="Voiture.Description" class="form-control" />
                <span asp-validation-for="Voiture.Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Voiture.AnneeFabrication" class="control-label"></label>
                <input asp-for="Voiture.AnneeFabrication" class="form-control" />
                <span asp-validation-for="Voiture.AnneeFabrication" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" name="btnAjouter" value="Ajouter" class="btn btn-success" />
            </div>
        </form>

    </div>
</div>