@page
@model GestionReservation.Pages.Voitures.ConsulterModel
@{
    ViewData["Title"] = "Consulter Voiture";
}

<h1>Détails sur la voiture</h1>


<div>
    <dl class="row">

        <dt class="col-sm-2">Marque</dt>
        <dd class="col-sm-10"> @Model.Voiture.Marque</dd>

        <dt class="col-sm-2">Prix</dt>
        <dd class="col-sm-10"> @Model.Voiture.PrixJournalier</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10"> @Model.Voiture.Description</dd>

        <dt class="col-sm-2">Année</dt>
        <dd class="col-sm-10"> @Model.Voiture.AnneeFabrication</dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Voiture.Id">Modifier</a> |
    <a asp-page="./Index">Retour à la liste</a>
</div>