@page
@using global::GestionReservations.Models
@model GestionReservations.Pages.Voitures.CreateModel

<h2>Ajouter une voiture</h2>

<form method="post">
    <div>
        <label>Marque</label>
        <select asp-for="Voiture.Marque" asp-items="Html.GetEnumSelectList<Marque>()"></select>
    </div>

    <div>
        <label>Prix</label>
        <input asp-for="Voiture.PrixJournalier" />
        <span asp-validation-for="Voiture.PrixJournalier"></span>
    </div>

    <div>
        <label>Description</label>
        <input asp-for="Voiture.Description" />
    </div>

    <div>
        <label>Année</label>
        <input asp-for="Voiture.AnneeFabrication"/>
    </div>
    <button type="submit">Ajouter</button>
</form>
