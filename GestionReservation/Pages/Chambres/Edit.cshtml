@page
@using global::GestionReservations.Models
@model GestionReservation.Pages.Chambres.EditModel
@{
    ViewData["Title"] = "Modification Chambre";
}

<h2>Modification d'une chambre</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">

            <input  asp-for=Chambre.Id type="hidden"/>

            <div class="form-group">
                <label>Description</label>
                <textarea asp-for="Chambre.Description" class="form-control" rows="5" cols="32"></textarea>
                <span asp-validation-for="Chambre.Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Prix</label>
                <input asp-for="Chambre.PrixJournalier" class="form-control" />
                <span asp-validation-for="Chambre.PrixJournalier" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" name="btnAjouter" value="Modifier" class="btn btn-success" /> |
                <a asp-page="Index">Retour à la liste</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}