@page
@using global::GestionReservations.Models
@model GestionReservation.Pages.Chambres.CreateModel
@{
}

<h2>Ajouter une chambre</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">

            <div class="form-group">
                <label>Description</label>
                <textarea asp-for="Chambre.Description" class="form-control" rows="5" cols="32"></textarea>
            </div>

            <div class="form-group">
                <label>Prix</label>
                <input asp-for="Chambre.PrixJournalier" class="form-control" />
                <span asp-validation-for="Chambre.PrixJournalier"></span>
            </div>      
            <br />
            <div class="form-group">
                <input type="submit" name="btnAjouter" value="Ajouter" class="btn btn-success" />
                <a asp-page="Index">Retour à la liste</a>
            </div>
        </form>

    </div>
</div>